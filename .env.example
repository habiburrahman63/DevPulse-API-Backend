# Comma-separated list of allowed browser origins (no trailing slash).
# Add every frontend that calls this API, including your deployed frontend.
#   CLIENT_ORIGIN=http://localhost:5173,https://dev-pulse-api-sepia.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas example. Replace the placeholders with your own credentials, or leave this
# empty to run without a database (the console then reports a clear "not configured" state).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT: required for the auth endpoints. Use a long random value (32+ characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave empty to disable authentication; the console then shows a "not configured" state.
JWT_SECRET=
JWT_EXPIRES_IN=1d